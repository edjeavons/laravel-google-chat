{
    "name": "eighteen73/laravel-google-chat",
    "description": "Google Chat Notification Channel for Laravel (fka. Hangouts Chat)",
    "homepage": "https://github.com/eighteen73/laravel-google-chat",
    "license": "MIT",
    "authors": [
        {
            "name": "eighteen73",
            "email": "ed@eighteen73.co.uk",
            "homepage": "https://eighteen73.co.uk"
        },
        {
            "name": "Frank Dixon",
            "email": "frank@thetreehouse.family",
            "homepage": "https://thetreehouse.family",
            "role": "Original Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.0",
        "illuminate/notifications": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "league/commonmark": "^2.8"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5.3"
    },
    "autoload": {
        "psr-4": {
            "NotificationChannels\\GoogleChat\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NotificationChannels\\GoogleChat\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text --coverage-clover=coverage.clover",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "NotificationChannels\\GoogleChat\\GoogleChatServiceProvider"
            ]
        }
    }
}
